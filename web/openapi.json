{
  "openapi": "3.0.3",
  "info": {
    "title": "Landy Heater REST API",
    "version": "1.0.0",
    "description": "Lokale HTTP-API der Landy-Heater-Steuerung. Alle Anfragen müssen denselben Host wie die Weboberfläche verwenden. Schreibzugriffe benötigen einen passenden Origin-Header und ein kurzlebiges CSRF-Token. Konfigurationsänderungen sind nur im Geräte-WLAN verfügbar; Heizungssteuerung ist zusätzlich im verbundenen Heim-WLAN möglich."
  },
  "servers": [{"url": "/", "description": "Dieses Landy-Heater-Steuergerät"}],
  "tags": [
    {"name": "Kontext", "description": "Sicherheitskontext und Zugriffstoken"},
    {"name": "Status", "description": "Laufzeitstatus und Diagnose"},
    {"name": "Capture", "description": "Begrenzte Diagnoseaufzeichnung"},
    {"name": "Zeit", "description": "Flüchtige Browserzeitsynchronisierung"},
    {"name": "Heizung", "description": "Manuelle Heizungssteuerung"},
    {"name": "Konfiguration", "description": "Persistente Gerätekonfiguration"},
    {"name": "Timer", "description": "Zeitplanverwaltung"}
  ],
  "x-landy-safety": "Die integrierte Ansicht führt niemals automatisch eine Operation aus. Lesezugriffe starten nur nach einem bewussten Klick; Schreibzugriffe benötigen zusätzlich eine ausdrückliche Bestätigung und Heizungsstarts das Bestätigungswort START.",
  "x-landy-request-limits": {"http":"HTTP/1.1","target_bytes":192,"json_body_bytes":4096,"json_response_bytes":8192},
  "x-landy-rate-limits": {"requests":"10 pro IPv4-Peer und 10 Sekunden","mutations":"2 pro IPv4-Peer und Sekunde","configuration_cooldown_seconds":5,"error":"429 mit Retry-After"},
  "paths": {
    "/api/v1/security-context": {
      "get": {"tags":["Kontext"],"summary":"Konfigurationstoken abrufen","description":"Nur im Geräte-WLAN verfügbar. Liefert das Token für persistente Änderungen.","operationId":"getSecurityContext","x-landy-ingress":"ap-only","responses":{"200":{"description":"Konfigurationstoken","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SecurityContextResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/control-context": {
      "get": {"tags":["Kontext"],"summary":"Steuerungstoken abrufen","description":"Im Geräte- und Stations-WLAN verfügbar. Liefert das Token für Heizungsbefehle.","operationId":"getControlContext","x-landy-ingress":"ap-and-station","responses":{"200":{"description":"Steuerungstoken","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ControlContextResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/status": {
      "get": {"tags":["Status"],"summary":"Gerätestatus lesen","operationId":"getStatus","x-landy-ingress":"ap-and-station","responses":{"200":{"description":"Netzwerk-, Heizungs-, Sensor-, Zeit- und Konfigurationsstatus","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StatusResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/diagnostics": {
      "get": {"tags":["Status"],"summary":"Diagnoseübersicht lesen","operationId":"getDiagnostics","x-landy-ingress":"ap-and-station","parameters":[{"$ref":"#/components/parameters/EventAfter"},{"$ref":"#/components/parameters/ProtocolAfter"}],"responses":{"200":{"description":"Live-Diagnose, Ereignisse und Protokoll","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ObjectResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/events": {
      "get": {"tags":["Status"],"summary":"Ereignisse seitenweise lesen","operationId":"getEvents","x-landy-ingress":"ap-and-station","parameters":[{"$ref":"#/components/parameters/After"},{"$ref":"#/components/parameters/EventLimit"}],"responses":{"200":{"description":"Ereignisse nach dem Cursor","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ObjectResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/protocol-log": {
      "get": {"tags":["Status"],"summary":"Heizungsprotokoll lesen","operationId":"getProtocolLog","x-landy-ingress":"ap-and-station","parameters":[{"$ref":"#/components/parameters/After"},{"$ref":"#/components/parameters/ProtocolLimit"}],"responses":{"200":{"description":"Begrenzte Protokolleinträge nach dem Cursor","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ObjectResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/capture": {
      "get": {"tags":["Capture"],"summary":"Capture-Status lesen","operationId":"getCapture","x-landy-ingress":"ap-and-station","responses":{"200":{"description":"Aktueller Capture-Status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CaptureResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}},
      "post": {"tags":["Capture"],"summary":"Capture starten","operationId":"startCapture","x-landy-ingress":"ap-only","security":[{"apCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CaptureRequest"}}}},"responses":{"201":{"description":"Capture gestartet","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ObjectResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}},
      "delete": {"tags":["Capture"],"summary":"Capture stoppen","operationId":"stopCapture","x-landy-ingress":"ap-only","security":[{"apCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"}],"responses":{"200":{"description":"Capture gestoppt","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ObjectResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/capture/export": {
      "get": {"tags":["Capture"],"summary":"Capture seitenweise exportieren","operationId":"exportCapture","x-landy-ingress":"ap-and-station","parameters":[{"$ref":"#/components/parameters/Offset"},{"$ref":"#/components/parameters/CaptureLimit"}],"responses":{"200":{"description":"Capture-Datensätze","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ObjectResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/time/browser-sync": {
      "put": {"tags":["Zeit"],"summary":"Browserzeit flüchtig übernehmen","description":"Setzt die Uhr bis zum nächsten Neustart, ohne die Konfiguration zu speichern.","operationId":"syncBrowserTime","x-landy-ingress":"ap-only","security":[{"apCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimeSyncRequest"}}}},"responses":{"200":{"description":"Zeit übernommen","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ObjectResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/heater/start": {
      "post": {"tags":["Heizung"],"summary":"Heizung konfiguriert starten","operationId":"startHeater","x-landy-ingress":"ap-and-station","security":[{"controlCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartRequest"}}}},"responses":{"200":{"description":"Anforderung war bereits aktiv","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/HeaterMutationResponse"}}}},"202":{"description":"Start angenommen","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/HeaterMutationResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/heater/quick-start": {
      "post": {"tags":["Heizung"],"summary":"Quick Start ausführen","operationId":"quickStartHeater","x-landy-ingress":"ap-and-station","security":[{"controlCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/QuickStartRequest"}}}},"responses":{"200":{"description":"Anforderung war bereits aktiv","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/HeaterMutationResponse"}}}},"202":{"description":"Quick Start angenommen","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/HeaterMutationResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/heater/stop": {
      "post": {"tags":["Heizung"],"summary":"Heizung stoppen","description":"Sicherer Wiederherstellungspfad; bleibt auch bei verriegelten übrigen Mutationen verfügbar.","operationId":"stopHeater","x-landy-ingress":"ap-and-station","x-landy-safety-path":true,"x-landy-rate-limit-bypass":true,"security":[{"controlCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"}],"responses":{"200":{"description":"Heizung war bereits aus","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HeaterMutationResponse"}}}},"202":{"description":"Stopp angenommen","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HeaterMutationResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/heater/session": {
      "patch": {"tags":["Heizung"],"summary":"Aktive Sitzung anpassen","operationId":"updateHeaterSession","x-landy-ingress":"ap-and-station","security":[{"controlCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SessionUpdateRequest"}}}},"responses":{"200":{"description":"Sitzung aktualisiert","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/HeaterSessionResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/settings": {
      "get": {"tags":["Konfiguration"],"summary":"Einstellungen lesen","operationId":"getSettings","x-landy-ingress":"ap-and-station","responses":{"200":{"description":"Öffentliche Einstellungen ohne Passwörter; ETag enthält die Generation","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SettingsResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}},
      "patch": {"tags":["Konfiguration"],"summary":"Einstellungen teilweise ändern","operationId":"patchSettings","x-landy-ingress":"ap-only","security":[{"apCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SettingsPatch"}}}},"responses":{"200":{"description":"Gespeicherte Einstellungen","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SettingsMutationResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/setup": {
      "get": {"tags":["Konfiguration"],"summary":"Setup-Zustand lesen","operationId":"getSetup","x-landy-ingress":"ap-and-station","responses":{"200":{"description":"Setup-Daten ohne Passwörter; ETag enthält die Generation","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetupResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}},
      "put": {"tags":["Konfiguration"],"summary":"Setup vollständig speichern","description":"Passwörter sind write-only und werden niemals zurückgegeben.","operationId":"completeSetup","x-landy-ingress":"ap-only","security":[{"apCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetupRequest"}}}},"responses":{"200":{"description":"Setup gespeichert","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SettingsMutationResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/timers": {
      "get": {"tags":["Timer"],"summary":"Timer seitenweise lesen","operationId":"getTimers","x-landy-ingress":"ap-and-station","parameters":[{"$ref":"#/components/parameters/TimerOffset"},{"$ref":"#/components/parameters/TimerLimit"}],"responses":{"200":{"description":"Timerseite; ETag enthält die Generation","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimerPageResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}},
      "post": {"tags":["Timer"],"summary":"Timer erstellen","operationId":"createTimer","x-landy-ingress":"ap-only","security":[{"apCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Timer"}}}},"responses":{"201":{"description":"Timer erstellt","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"},"Location":{"description":"Kanonischer Timerpfad","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimerMutationResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/timers/~id/{timer_id_hex}": {
      "parameters":[{"$ref":"#/components/parameters/TimerIdHex"}],
      "get": {"tags":["Timer"],"summary":"Timer lesen","operationId":"getTimer","x-landy-ingress":"ap-and-station","responses":{"200":{"description":"Timer; ETag enthält die Generation","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimerItemResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}},
      "put": {"tags":["Timer"],"summary":"Timer vollständig ersetzen","operationId":"replaceTimer","x-landy-ingress":"ap-only","security":[{"apCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Timer"}}}},"responses":{"200":{"description":"Timer ersetzt","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimerMutationResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}},
      "delete": {"tags":["Timer"],"summary":"Timer löschen","operationId":"deleteTimer","x-landy-ingress":"ap-only","security":[{"apCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/IfMatch"}],"responses":{"200":{"description":"Timer gelöscht","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimerDeleteResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    },
    "/api/v1/timers/{timer_id}": {
      "parameters":[{"$ref":"#/components/parameters/TimerId"}],
      "get": {"tags":["Timer"],"summary":"Timer über kompatiblen Segmentpfad lesen","operationId":"getTimerBySegment","deprecated":true,"x-landy-ingress":"ap-and-station","responses":{"200":{"description":"Timer; ETag enthält die Generation","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimerItemResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}},
      "put": {"tags":["Timer"],"summary":"Timer über kompatiblen Segmentpfad ersetzen","operationId":"replaceTimerBySegment","deprecated":true,"x-landy-ingress":"ap-only","security":[{"apCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/IfMatch"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Timer"}}}},"responses":{"200":{"description":"Timer ersetzt","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimerMutationResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}},
      "delete": {"tags":["Timer"],"summary":"Timer über kompatiblen Segmentpfad löschen","operationId":"deleteTimerBySegment","deprecated":true,"x-landy-ingress":"ap-only","security":[{"apCsrf":[]}],"parameters":[{"$ref":"#/components/parameters/Origin"},{"$ref":"#/components/parameters/IfMatch"}],"responses":{"200":{"description":"Timer gelöscht","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimerDeleteResponse"}}}},"default":{"$ref":"#/components/responses/Error"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "apCsrf": {"type":"apiKey","in":"header","name":"X-Landy-CSRF","description":"Token aus GET /api/v1/security-context; nur im Geräte-WLAN erhältlich."},
      "controlCsrf": {"type":"apiKey","in":"header","name":"X-Landy-CSRF","description":"Token aus GET /api/v1/control-context; im Geräte- und Stations-WLAN erhältlich."}
    },
    "parameters": {
      "Origin": {"name":"Origin","in":"header","required":true,"description":"Exakter Ursprung der geöffneten Geräteoberfläche, zum Beispiel http://192.168.4.1.","schema":{"type":"string"}},
      "IfMatch": {"name":"If-Match","in":"header","required":true,"description":"Aktuelles Konfigurations-ETag, Format \"config-N\"; N darf höchstens 2147483647 sein.","schema":{"type":"string","pattern":"^\\\"config-(0|[1-9][0-9]{0,9})\\\"$"}},
      "After": {"name":"after","in":"query","required":false,"schema":{"type":"integer","minimum":0,"maximum":2147483647,"default":0}},
      "EventAfter": {"name":"event_after","in":"query","required":false,"description":"Nur gemeinsam mit protocol_after angeben.","schema":{"type":"integer","minimum":0,"maximum":2147483647}},
      "ProtocolAfter": {"name":"protocol_after","in":"query","required":false,"description":"Nur gemeinsam mit event_after angeben.","schema":{"type":"integer","minimum":0,"maximum":2147483647}},
      "Offset": {"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"maximum":2147483647,"default":0}},
      "EventLimit": {"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":16,"default":16}},
      "ProtocolLimit": {"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":4,"default":4}},
      "CaptureLimit": {"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":4,"default":4}},
      "TimerOffset": {"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"maximum":32,"default":0}},
      "TimerLimit": {"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":8,"default":8}},
      "TimerId": {"name":"timer_id","in":"path","required":true,"deprecated":true,"description":"Kompatibilitätsform. UTF-8-ID als einzelnes percent-kodiertes Segment; neue Clients verwenden den Hex-Pfad.","schema":{"type":"string","minLength":1,"maxLength":64}},
      "TimerIdHex": {"name":"timer_id_hex","in":"path","required":true,"description":"Hexadezimale UTF-8-Kodierung der Timer-ID; die kanonische Location verwendet Kleinbuchstaben.","schema":{"type":"string","pattern":"^(?:[0-9A-Fa-f]{2})+$","minLength":2,"maxLength":128}}
    },
    "headers": {
      "ConfigETag": {"description":"Aktuelle persistente Konfigurationsgeneration.","schema":{"type":"string","pattern":"^\\\"config-[0-9]+\\\"$"}}
    },
    "responses": {
      "Error": {"description":"Fehlerantwort. Mögliche Status: 400, 403, 404, 405, 406, 409, 412, 415, 422, 428, 429, 500 oder 503.","headers":{"ETag":{"$ref":"#/components/headers/ConfigETag"},"Retry-After":{"description":"Wartezeit nach Rate-Limit in Sekunden.","schema":{"type":"integer"}},"Allow":{"description":"Erlaubte Methoden bei Status 405.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}
    },
    "schemas": {
      "ObjectResponse": {"type":"object","required":["api_version","request_id"],"properties":{"api_version":{"type":"integer","enum":[1]},"request_id":{"type":"integer"}},"additionalProperties":true},
      "StatusResponse": {"allOf":[{"$ref":"#/components/schemas/ObjectResponse"},{"type":"object","required":["configuration","heater","temperatures","time","scheduler","network","warnings"],"properties":{"configuration":{"type":"object"},"heater":{"type":"object"},"temperatures":{"type":"object"},"time":{"type":"object"},"scheduler":{"type":"object"},"network":{"type":"object"},"warnings":{"type":"array","maxItems":16,"items":{"type":"string"}}}}]},
      "HeaterMutationResponse": {"allOf":[{"$ref":"#/components/schemas/ObjectResponse"},{"type":"object","required":["changed","heater"],"properties":{"changed":{"type":"boolean"},"heater":{"type":"object"}}}]},
      "HeaterSessionResponse": {"allOf":[{"$ref":"#/components/schemas/ObjectResponse"},{"type":"object","required":["updated","heater"],"properties":{"updated":{"type":"boolean"},"heater":{"type":"object"}}}]},
      "CaptureResponse": {"allOf":[{"$ref":"#/components/schemas/ObjectResponse"},{"type":"object","required":["capture"],"properties":{"capture":{"type":"object"}}}]},
      "SettingsResponse": {"allOf":[{"$ref":"#/components/schemas/ObjectResponse"},{"type":"object","required":["generation","schema_version","system","heater","sensors","time","network","network_services","restart_required"],"properties":{"generation":{"type":"integer","minimum":0},"schema_version":{"type":"integer"},"system":{"type":"object"},"heater":{"$ref":"#/components/schemas/HeaterSettings"},"sensors":{"$ref":"#/components/schemas/SensorSettings"},"time":{"$ref":"#/components/schemas/TimeSettings"},"network":{"type":"object"},"network_services":{"$ref":"#/components/schemas/NetworkServices"},"restart_required":{"type":"boolean"}}}]},
      "SettingsMutationResponse": {"allOf":[{"$ref":"#/components/schemas/SettingsResponse"},{"type":"object","required":["changed"],"properties":{"changed":{"type":"boolean"}}}]},
      "SetupResponse": {"allOf":[{"$ref":"#/components/schemas/SettingsResponse"},{"type":"object","required":["checks"],"properties":{"checks":{"type":"object","required":["rtc","sensors","autoterm"]}}}]},
      "TimerPageResponse": {"allOf":[{"$ref":"#/components/schemas/ObjectResponse"},{"type":"object","required":["generation","restart_required","offset","limit","total","items"],"properties":{"generation":{"type":"integer","minimum":0},"restart_required":{"type":"boolean"},"offset":{"type":"integer"},"limit":{"type":"integer"},"total":{"type":"integer","maximum":32},"items":{"type":"array","maxItems":8,"items":{"$ref":"#/components/schemas/Timer"}}}}]},
      "TimerItemResponse": {"allOf":[{"$ref":"#/components/schemas/ObjectResponse"},{"type":"object","required":["generation","timer"],"properties":{"generation":{"type":"integer","minimum":0},"timer":{"$ref":"#/components/schemas/Timer"}}}]},
      "TimerMutationResponse": {"allOf":[{"$ref":"#/components/schemas/TimerItemResponse"},{"type":"object","required":["changed","restart_required"],"properties":{"changed":{"type":"boolean"},"restart_required":{"type":"boolean"}}}]},
      "TimerDeleteResponse": {"allOf":[{"$ref":"#/components/schemas/ObjectResponse"},{"type":"object","required":["generation","changed","deleted","restart_required"],"properties":{"generation":{"type":"integer","minimum":0},"changed":{"type":"boolean","enum":[true]},"deleted":{"type":"boolean","enum":[true]},"restart_required":{"type":"boolean"}}}]},
      "SecurityContextResponse": {"allOf":[{"$ref":"#/components/schemas/ObjectResponse"},{"type":"object","required":["csrf_token","mutation_api_available"],"properties":{"csrf_token":{"type":"string","pattern":"^[0-9a-f]{64}$"},"mutation_api_available":{"type":"boolean","enum":[true]}}}]},
      "ControlContextResponse": {"allOf":[{"$ref":"#/components/schemas/ObjectResponse"},{"type":"object","required":["csrf_token","control_api_available"],"properties":{"csrf_token":{"type":"string","pattern":"^[0-9a-f]{64}$"},"control_api_available":{"type":"boolean","enum":[true]}}}]},
      "ErrorResponse": {"type":"object","required":["api_version","error"],"properties":{"api_version":{"type":"integer","enum":[1]},"error":{"type":"object","required":["code","message","request_id"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"request_id":{"type":"integer"}},"additionalProperties":true}},"additionalProperties":false},
      "CaptureRequest": {"type":"object","required":["label"],"properties":{"label":{"type":"string","minLength":1,"maxLength":64}},"additionalProperties":false},
      "TimeSyncRequest": {"type":"object","required":["unix_epoch_seconds"],"properties":{"unix_epoch_seconds":{"type":"integer","minimum":946684800,"maximum":4102444799,"description":"Unix-Zeit in Sekunden seit 1970-01-01 UTC."}},"additionalProperties":false},
      "QuickStartRequest": {"type":"object","required":["expected_request_revision"],"properties":{"expected_request_revision":{"type":"integer","minimum":0}},"additionalProperties":false},
      "StartRequest": {"type":"object","required":["expected_request_revision","mode","target_temperature","power_level","runtime_minutes"],"properties":{"expected_request_revision":{"type":"integer","minimum":0},"mode":{"$ref":"#/components/schemas/Mode"},"target_temperature":{"type":"integer","nullable":true,"minimum":5,"maximum":30},"power_level":{"type":"integer","nullable":true,"minimum":1,"maximum":9},"runtime_minutes":{"type":"integer","minimum":1}},"additionalProperties":false},
      "SessionUpdateRequest": {"type":"object","required":["expected_request_revision","target_temperature","extend_minutes"],"properties":{"expected_request_revision":{"type":"integer","minimum":0},"target_temperature":{"type":"integer","nullable":true,"minimum":5,"maximum":30},"extend_minutes":{"type":"integer","enum":[0,15]}},"additionalProperties":false},
      "Mode": {"type":"string","enum":["roof_tent_temperature","cabin_temperature","power"]},
      "StartProfile": {"type":"object","required":["mode","target_temperature","power_level","runtime_minutes"],"properties":{"mode":{"$ref":"#/components/schemas/Mode"},"target_temperature":{"type":"integer","nullable":true,"minimum":5,"maximum":30},"power_level":{"type":"integer","nullable":true,"minimum":1,"maximum":9},"runtime_minutes":{"type":"integer","minimum":1}},"additionalProperties":false},
      "HeaterSettings": {"type":"object","required":["maximum_runtime_minutes","quick_start"],"properties":{"maximum_runtime_minutes":{"type":"integer","minimum":1,"maximum":120},"quick_start":{"$ref":"#/components/schemas/StartProfile"}},"additionalProperties":false},
